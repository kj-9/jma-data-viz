{
  "version": 8,
  "name": "jma-viz",
  "sources": {
    "mesh-source": {
      "type": "vector",
      "url": "http://[::]:8080/data/pmtiles.json"
    },
    "white-map": {
      "type": "raster",
      "tiles": [
        "https://a.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png",
        "https://b.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png",
        "https://c.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png",
        "https://d.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png"
      ],
      "minzoom": 0,
      "maxzoom": 20,
      "attribution": "&copy; OpenStreetMap contributors &copy; CARTO"
    }
  },
  "sprite": "",
  "glyphs": "https://orangemug.github.io/font-glyphs/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "ocean-background",
      "type": "background",
      "paint": {
        "background-color": "#12243a",
        "background-opacity": 1
      }
    },
    {
      "id": "white-map",
      "type": "raster",
      "source": "white-map",
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "raster-opacity": 0.82
      }
    },
    {
      "id": "mesh-fill",
      "type": "fill",
      "source": "mesh-source",
      "source-layer": "mesh",
      "minzoom": 3,
      "maxzoom": 24,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "get",
            "max_temp"
          ],
          -15,
          "#8fc7fb",
          0,
          "#67a8e4",
          10,
          "#417fbe",
          20,
          "#455f8d",
          25,
          "#d19f69",
          30,
          "#e57d4f",
          35,
          "#ef5a3b",
          40,
          "#dc382d"
        ],
        "fill-opacity": 0.56
      }
    },
    {
      "id": "mesh-outline",
      "type": "line",
      "source": "mesh-source",
      "source-layer": "mesh",
      "minzoom": 9,
      "maxzoom": 24,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "line-color": "rgba(255, 255, 255, 0.07)",
        "line-width": 0.25,
        "line-opacity": 0.3
      }
    },
    {
      "id": "mesh-symbol",
      "type": "symbol",
      "source": "mesh-source",
      "source-layer": "mesh",
      "minzoom": 9,
      "layout": {
        "text-field": [
          "get",
          "max_temp"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          10,
          11,
          11,
          12,
          12,
          13,
          13
        ],
        "text-padding": 0,
        "text-max-width": 4,
        "text-allow-overlap": false,
        "visibility": "visible"
      },
      "paint": {
        "text-color": "rgba(255, 255, 255, 0.98)",
        "text-halo-color": "rgba(6, 10, 18, 0.98)",
        "text-halo-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1.2,
          11,
          1.6,
          12,
          1.9,
          14,
          2.3
        ],
        "text-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.78,
          11,
          0.86,
          12,
          0.92,
          13,
          0.96
        ]
      }
    }
  ]
}
